@using System.Text.Json
@using scada_demo_test.Domain.Constants
@using scada_demo_test.Web.Services
@page "/infrastructure"
@attribute [Authorize(Policy = "Tab:Devices")]
@attribute [Authorize(Policy = $"Action:{AppPermissions.DevicesView}")]
@inject ScadaDemoTestApiClient Api
@inject LiveTelemetryState Live
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>View Gateway and Sensors</PageTitle>

<div class="infrastructure-page">
    <header class="infra-heading">
        <div><div class="infra-eyebrow">Connectivity &amp; instrumentation</div><h1>View Gateway and Sensors</h1><p>Your connected infrastructure. One clear view.</p></div>
        <AuthorizeView Policy="Action:Devices.Add"><Authorized><button class="btn-primary-scada" @onclick="GoToGateway">＋ Add device</button></Authorized></AuthorizeView>
    </header>

    <section class="infra-metrics" aria-label="Infrastructure summary">
        <div class="infra-metric"><span class="infra-metric-icon">▤</span><div><small>Total devices</small><strong>@Devices.Count</strong><em>Controllers &amp; gateways</em></div></div>
        <div class="infra-metric"><span class="infra-metric-icon">◉</span><div><small>Devices online</small><strong>@Devices.Count(d => d.IsOnline)</strong><em>Current API status</em></div></div>
        <div class="infra-metric"><span class="infra-metric-icon">⌁</span><div><small>Connected sensors</small><strong>@Sensors.Count</strong><em>Across all devices</em></div></div>
        <div class="infra-metric alert"><span class="infra-metric-icon">!</span><div><small>Sensors offline / stale</small><strong>@Sensors.Count(s => !SensorOnline(s))</strong><em>Require attention</em></div></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Error)) { <div class="infra-error" role="alert">@Error</div> }
    @if (Loading) { <div class="infra-empty">Loading infrastructure…</div> }
    else if (SelectedDevice is null)
    {
        <section class="infra-panel">
            <div class="infra-panel-heading"><div><h2>Gateways &amp; controllers</h2><p>Select a device to explore its connected sensors.</p></div><span>@FilteredDevices.Count() devices</span></div>
            <div class="infra-toolbar"><input type="search" aria-label="Search devices" placeholder="Search name or IP address…" @bind="DeviceQuery" @bind:event="oninput" /><div class="infra-filters">@foreach (var f in DeviceFilters) { <button class="@(DeviceFilter == f ? "active" : "")" @onclick="() => DeviceFilter = f">@f</button> }</div></div>
            @if (FilteredDevices.Count() == 0) { <div class="infra-empty">No devices match the current search or filter.</div> }
             else { <div class="gateway-grid">@foreach (var d in FilteredDevices) { <button class="gateway-card connection-card @(d.IsOnline ? "is-online" : "is-offline")" @onclick="() => SelectDevice(d)"><div class="card-top"><span class="type-tag">@DeviceType(d)</span><span class="status-badge @(d.IsOnline ? "online" : "offline")">@(d.IsOnline ? "online" : "offline")</span></div><div class="device-art"><img src="@DevicePhoto(d)" alt="@DeviceType(d) device" /></div><h3>@d.Name</h3><p>@(IsNorvi(d) ? "Industrial controller for distributed process I/O." : "Industrial serial-to-network data gateway.")</p><dl><div><dt>Address</dt><dd>@(d.IpAddress ?? "Not configured")</dd></div><div><dt>Port</dt><dd>@d.Port</dd></div></dl><footer><span>@Sensors.Count(s => s.DeviceId == d.Id) sensors</span><b>View sensors →</b></footer></button> }</div>}
        </section>
    }
    else
    {
        <div class="drill-nav"><button class="back-button" @onclick="ClearSelection">← Back to all devices</button><span><strong>@SelectedDevice.Name</strong> · @(SelectedDevice.IpAddress ?? "No address")</span></div>
        <header class="infra-drill-heading"><div><div class="infra-eyebrow">Device drill-down</div><h1>@SelectedDevice.Name</h1><p>@(SelectedDevice.IpAddress ?? "No address") · @DeviceType(SelectedDevice)</p></div><span>@SelectedSensors.Count() sensors</span></header>
         <div class="gateway-summary connection-card @(SelectedDevice.IsOnline ? "is-online" : "is-offline")"><div class="device-art"><img src="@DevicePhoto(SelectedDevice)" alt="@DeviceType(SelectedDevice) device" /></div><div><h2>@SelectedDevice.Name</h2><p>@SelectedDevice.HardwareType · @(SelectedDevice.IpAddress ?? "No address"):@SelectedDevice.Port</p><span class="status-badge @(SelectedDevice.IsOnline ? "online" : "offline")">@(SelectedDevice.IsOnline ? "Online" : "Offline")</span></div></div>
        <section class="infra-panel"><div class="infra-panel-heading"><div><h2>Connected sensors <small>/ Slave matrix</small></h2></div><span>Green · Online &nbsp; Red · Offline</span></div><div class="infra-toolbar"><input type="search" aria-label="Search sensors" placeholder="Search sensor, category, or slave ID…" @bind="SensorQuery" @bind:event="oninput" /><select aria-label="Filter sensor category" @bind="CategoryFilter"><option>All categories</option>@foreach (var c in CategoriesForSelection) { <option>@c</option> }</select><div class="infra-filters">@foreach (var f in SensorFilters) { <button class="@(SensorFilter == f ? "active" : "")" @onclick="() => SensorFilter = f">@f</button> }</div></div>
            @if (FilteredSensors.Count() == 0) { <div class="infra-empty">No sensors match the current search or filter.</div> }
             else
             {
                <div class="sensor-grid">
                    @foreach (var sensor in FilteredSensors.OrderBy(s => CategoryOrder.IndexOf(CategoryOf(s))).ThenBy(s => s.Name))
                    {
                        var metrics = CardMetrics(sensor).OrderByDescending(x => x.Value.Seen).ToList();
                        var liveMetrics = FreshMetrics(sensor).OrderByDescending(x => x.Value.Seen).ToList();
                        var online = SensorOnline(sensor);
                        <button class="sensor-card connection-card @(online ? "is-online" : "is-offline")" @ref="_sensorButtonRefs[sensor.Id]" @onclick="() => OpenSensor(sensor)">
                            <div class="sensor-top">
                                <span class="slave-label">Slave @sensor.SlaveAddress</span>
                                <span class="status-badge @(online ? "online" : "offline")">@(online ? "online" : "offline")</span>
                            </div>
                            <div class="sensor-symbol" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 13c3.5 0 3.5-6 7-6s3.5 8 7 8 3.5-5 7-5" />
                                </svg>
                            </div>
                            <h4>@sensor.Name</h4>
                            <p>@DriverName(sensor)</p>
                            @if (online && metrics.Count > 0)
                            {
                                var metric = metrics[0];
                                var trendPoints = LiveTrendPoints(sensor, metric.Key);
                                <div class="reading"><strong>@metric.Value.Value.ToString("0.##")</strong><span>@(metric.Value.Unit ?? "")</span></div>
                                @if (!string.IsNullOrEmpty(trendPoints))
                                {
                                    <svg class="sensor-sparkline" viewBox="0 0 100 24" role="img" aria-label="Recent live trend for @sensor.Name">
                                        <polyline points="@trendPoints" />
                                    </svg>
                                }
                                <div class="sensor-updated">@metric.Key · Updated @metric.Value.Seen.ToLocalTime().ToString("HH:mm:ss")</div>
                            }
                            else
                            {
                                <div class="offline-note">@(online ? "No saved reading available" : "No recent sensor data")</div>
                            }
                            <footer>
                                @if (online && liveMetrics.Count > 0)
                                {
                                    <span>Live · updated @liveMetrics[0].Value.Seen.ToLocalTime().ToString("HH:mm")</span>
                                }
                                else if (metrics.Count > 0)
                                {
                                    <span>Last sample · @metrics[0].Value.Seen.ToLocalTime().ToString("HH:mm")</span>
                                }
                                else if (sensor.LatestTimestampUtc.HasValue)
                                {
                                    <span>Last sample · @sensor.LatestTimestampUtc.Value.ToLocalTime().ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span>Waiting for real sensor data</span>
                                }
                            </footer>
                        </button>
                    }
                </div>
            }
        </section>
    }
</div>

@if (DetailSensor is not null)
{
    <div class="infra-modal-backdrop" @onclick="CloseSensor">
        <div class="infra-modal sensor-detail-modal" role="dialog" aria-modal="true" aria-labelledby="sensor-detail-title" tabindex="-1" @onkeydown="HandleModalKey" @onclick:stopPropagation>
             <div class="sensor-detail-summary">
                 <div class="sensor-detail-title-row">
                     <div>
                         <div class="infra-eyebrow">Sensor detail</div>
                         <h2 id="sensor-detail-title">@DetailSensor.Name</h2>
                         <p>@DetailSensor.UniqueSensorId · @DriverName(DetailSensor) · @CategoryOf(DetailSensor)</p>
                     </div>
                     <button class="modal-close" aria-label="Close sensor detail" @ref="_modalCloseButton" @onclick="CloseSensor">×</button>
                 </div>
                 <div class="detail-stats">
                     <div><strong>@DetailValue</strong><span>@DetailUnit</span></div>
                     <div><strong>@(SensorOnline(DetailSensor) ? "Online" : "Offline / stale")</strong><span>Status</span></div>
                    <div><strong>@DetailSensor.SlaveAddress</strong><span>Modbus slave</span></div>
                </div>
                <dl class="detail-meta">
                    <div><dt>Device</dt><dd>@DetailSensor.DeviceName</dd></div>
                    <div><dt>Gateway</dt><dd>@(SelectedDevice?.IpAddress ?? "—"):@(SelectedDevice?.Port)</dd></div>
                    <div><dt>Category</dt><dd>@CategoryOf(DetailSensor)</dd></div>
                    <div><dt>Updated</dt><dd>@(DetailSensor.LatestTimestampUtc?.ToLocalTime().ToString("g") ?? "No updated reading")</dd></div>
                </dl>
            </div>
             <section class="sensor-history">
                 <div class="sensor-history-heading"><h3>Live trend</h3><span>Actual samples · max @DetailHistoryLimit</span></div>
                 <div class="sensor-history-scroll">
                     @if (DetailHistoryLoading)
                     {
                         <div class="history-state">Loading recent history…</div>
                     }
                     else if (DetailHistoryError is not null)
                     {
                         <div class="history-state" role="alert">@DetailHistoryError</div>
                     }
                     else if (DetailHistory.Count > 0)
                     {
                         <svg class="sensor-trend" viewBox="0 0 720 220" role="img" aria-label="Real sensor trend for @DetailSensor.Name">
                             <line class="trend-axis" x1="48" y1="18" x2="48" y2="188" />
                             <line class="trend-axis" x1="48" y1="188" x2="700" y2="188" />
                             <polyline class="trend-line" points="@TrendPoints" />
                             @foreach (var point in TrendMarkers) { <circle class="trend-point" cx="@point.X" cy="@point.Y" r="3.5" /> }
                             <text class="trend-label" x="48" y="210">@TrendStartLabel</text>
                             <text class="trend-label" x="700" y="210" text-anchor="end">@TrendEndLabel</text>
                             <text class="trend-label" x="40" y="24" text-anchor="end">@TrendMaxLabel</text>
                             <text class="trend-label" x="40" y="188" text-anchor="end">@TrendMinLabel</text>
                         </svg>
                         <div class="trend-summary">@DetailHistory.Count real samples · @DetailValue @DetailUnit currently shown</div>
                     }
                    else
                    {
                        <div class="offline-note">No real history samples available.</div>
                    }
                </div>
            </section>
        </div>
    </div>
}

@code {
    private const int DetailHistoryLimit = 50;
    private readonly CancellationTokenSource _disposeCts = new();
    private CancellationTokenSource? _historyCts;
    private long _selectionVersion;
    private long _detailVersion;
    private bool DetailHistoryLoading;
    private string? DetailHistoryError;
    private ElementReference _modalCloseButton;
    private readonly Dictionary<Guid, ElementReference> _sensorButtonRefs = new();
    private Guid? _focusReturnSensorId;
    private bool _focusModalOnRender;
    private bool _focusReturnOnRender;
    private List<ScadaDemoTestApiClient.GatewayDeviceDto> Devices = new();
    private List<ScadaDemoTestApiClient.AttachedSensorDto> Sensors = new();
    private readonly string[] DeviceFilters = ["All devices", "NORVI controllers", "Gateways"];
    private readonly string[] SensorFilters = ["All sensors", "Online", "Offline"];
    private readonly List<string> CategoryOrder = ["Water", "Steam", "Gas", "Air", "Temperature & RH", "Water Quality", "Electrical & Mechanical", "Other"];
    private string DeviceFilter = "All devices", SensorFilter = "All sensors", CategoryFilter = "All categories", DeviceQuery = "", SensorQuery = "";
    private bool Loading = true; private string? Error; private ScadaDemoTestApiClient.GatewayDeviceDto? SelectedDevice; private ScadaDemoTestApiClient.AttachedSensorDto? DetailSensor; private List<ScadaDemoTestApiClient.SensorReadingDto> DetailHistory = new(); private PeriodicTimer? _refreshTimer;
    private IEnumerable<ScadaDemoTestApiClient.GatewayDeviceDto> FilteredDevices => Devices.Where(d => (string.IsNullOrWhiteSpace(DeviceQuery) || $"{d.Name} {d.IpAddress} {d.HardwareType}".Contains(DeviceQuery, StringComparison.OrdinalIgnoreCase)) && (DeviceFilter == "All devices" || (DeviceFilter == "NORVI controllers" ? IsNorvi(d) : !IsNorvi(d))));
    private IEnumerable<ScadaDemoTestApiClient.AttachedSensorDto> SelectedSensors => SelectedDevice is null ? [] : Sensors.Where(s => s.DeviceId == SelectedDevice.Id);
    private IEnumerable<ScadaDemoTestApiClient.AttachedSensorDto> FilteredSensors => SelectedSensors.Where(s => (string.IsNullOrWhiteSpace(SensorQuery) || $"{s.Name} {s.UniqueSensorId} {s.SensorTypeKey} {CategoryOf(s)}".Contains(SensorQuery, StringComparison.OrdinalIgnoreCase)) && (CategoryFilter == "All categories" || CategoryOf(s) == CategoryFilter) && (SensorFilter == "All sensors" || (SensorFilter == "Online" ? SensorOnline(s) : !SensorOnline(s))));
    private IEnumerable<string> CategoriesForSelection => SelectedSensors.Select(CategoryOf).Distinct().OrderBy(c => CategoryOrder.IndexOf(c));
    private string DetailValue => DetailSensor is null ? "—" : SensorOnline(DetailSensor) && CardMetrics(DetailSensor).OrderByDescending(v => v.Value.Seen).FirstOrDefault() is { } m ? m.Value.Value.ToString("0.##") : "—";
    private string DetailUnit => DetailSensor is null ? "No reading" : SensorOnline(DetailSensor) && CardMetrics(DetailSensor).OrderByDescending(v => v.Value.Seen).FirstOrDefault() is { } m ? m.Value.Unit ?? "" : "No reading";
    protected override async Task OnInitializedAsync()
    {
        Live.OnChange += OnLiveChange;
        var token = _disposeCts.Token;
        await Live.EnsureConnectedAsync();
        if (token.IsCancellationRequested) return;
        await RefreshAsync(token);
        if (!token.IsCancellationRequested) _ = RefreshLoopAsync(token);
    }
    private async Task RefreshLoopAsync(CancellationToken token) { _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(5)); try { while (await _refreshTimer.WaitForNextTickAsync(token)) { if (DetailSensor is not null) continue; await RefreshAsync(token); } } catch (OperationCanceledException) { } catch { /* circuit shutdown */ } }
    private async Task RefreshAsync(CancellationToken token) { if (DetailSensor is not null) return; try { var selectionVersion = _selectionVersion; var detailVersion = _detailVersion; var selectedDeviceId = SelectedDevice?.Id; var detailSensorId = DetailSensor?.Id; var devicesTask = Api.GetGatewayDevicesAsync(); var sensorsTask = Api.GetSensorsAsync(); await Task.WhenAll(devicesTask, sensorsTask); token.ThrowIfCancellationRequested(); var devices = await devicesTask; var sensors = await sensorsTask; Devices = devices.OrderBy(d => d.Name).ToList(); Sensors = sensors.Where(s => s.IsActive).ToList(); if (_selectionVersion == selectionVersion) SelectedDevice = selectedDeviceId is Guid did ? Devices.FirstOrDefault(d => d.Id == did) : null; else if (SelectedDevice is { } currentDevice) SelectedDevice = Devices.FirstOrDefault(d => d.Id == currentDevice.Id); if (_detailVersion == detailVersion) DetailSensor = detailSensorId is Guid sid ? Sensors.FirstOrDefault(s => s.Id == sid) : null; else if (DetailSensor is { } currentSensor) DetailSensor = Sensors.FirstOrDefault(s => s.Id == currentSensor.Id); if (SelectedDevice is null) DetailSensor = null; Error = null; } catch (OperationCanceledException) { } catch { if (!token.IsCancellationRequested) Error = "Infrastructure could not be refreshed. Please try again."; } finally { Loading = false; if (!token.IsCancellationRequested) { try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { } catch (InvalidOperationException) { } } } }
    private async void OnLiveChange() { if (_disposeCts.IsCancellationRequested) return; try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { } catch (InvalidOperationException) { } }
    private void SelectDevice(ScadaDemoTestApiClient.GatewayDeviceDto d) { _selectionVersion++; SelectedDevice = d; SensorQuery = ""; SensorFilter = "All sensors"; CategoryFilter = "All categories"; }
    private void ClearSelection() { _selectionVersion++; _detailVersion++; SelectedDevice = null; DetailSensor = null; }
    private async Task OpenSensor(ScadaDemoTestApiClient.AttachedSensorDto s) { CancelHistoryRequest(); _detailVersion++; var detailVersion = _detailVersion; var requestCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token); _historyCts = requestCts; var token = requestCts.Token; DetailSensor = s; DetailHistory = new(); DetailHistoryError = null; DetailHistoryLoading = true; _focusReturnSensorId = s.Id; _focusModalOnRender = true; _focusReturnOnRender = false; await InvokeAsync(StateHasChanged); try { var history = await Api.GetSensorTelemetryAsync(s.Id, DetailHistoryLimit).WaitAsync(token); token.ThrowIfCancellationRequested(); if (_detailVersion == detailVersion && DetailSensor?.Id == s.Id) { DetailHistory = NormalizeHistory(history); DetailHistoryError = null; } } catch (OperationCanceledException) { } catch { if (_detailVersion == detailVersion && DetailSensor?.Id == s.Id) DetailHistoryError = "Recent history could not be loaded."; } finally { if (ReferenceEquals(_historyCts, requestCts)) { _historyCts = null; if (_detailVersion == detailVersion && DetailSensor?.Id == s.Id) { DetailHistoryLoading = false; try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { } catch (InvalidOperationException) { } } } requestCts.Dispose(); } }
    private void CloseSensor() { _detailVersion++; CancelHistoryRequest(); DetailSensor = null; DetailHistoryLoading = false; DetailHistoryError = null; _focusModalOnRender = false; _focusReturnOnRender = true; }
    private void CancelHistoryRequest() { var requestCts = _historyCts; _historyCts = null; requestCts?.Cancel(); }
    private static List<ScadaDemoTestApiClient.SensorReadingDto> NormalizeHistory(IEnumerable<ScadaDemoTestApiClient.SensorReadingDto> history) => history.Where(r => r.TimestampUtc != default && double.IsFinite(r.PrimaryValue) && double.IsFinite(r.SecondaryValue)).GroupBy(r => r.TimestampUtc).Select(g => g.OrderByDescending(r => r.ConnectionStatus).ThenByDescending(r => r.PrimaryValue).ThenByDescending(r => r.SecondaryValue).ThenBy(r => r.ErrorCode ?? string.Empty).First()).OrderBy(r => r.TimestampUtc).TakeLast(DetailHistoryLimit).ToList();
    private void HandleModalKey(KeyboardEventArgs e) { if (e.Key == "Escape") CloseSensor(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (_focusModalOnRender) { _focusModalOnRender = false; try { await _modalCloseButton.FocusAsync(); } catch (InvalidOperationException) { } } else if (_focusReturnOnRender) { _focusReturnOnRender = false; if (_focusReturnSensorId is Guid sensorId && _sensorButtonRefs.TryGetValue(sensorId, out var sensorButton)) { try { await sensorButton.FocusAsync(); } catch (InvalidOperationException) { } } } }
    private void GoToGateway() => Navigation.NavigateTo("/gateway");
    private static bool IsNorvi(ScadaDemoTestApiClient.GatewayDeviceDto d) => d.HardwareType.Contains("norvi", StringComparison.OrdinalIgnoreCase) || d.ProvisionedVia.Contains("norvi", StringComparison.OrdinalIgnoreCase);
    private static string DeviceType(ScadaDemoTestApiClient.GatewayDeviceDto d) => IsNorvi(d) ? "NORVI controller" : "Gateway";
    private static string DriverName(ScadaDemoTestApiClient.AttachedSensorDto s) => (s.DriverDisplayName ?? s.SensorTypeKey).Split('(')[0].Trim();
    private static string DevicePhoto(ScadaDemoTestApiClient.GatewayDeviceDto d) => IsNorvi(d) ? "/images/norvi.png" : "/images/gatway.png";
    private string CategoryOf(ScadaDemoTestApiClient.AttachedSensorDto s) { var driver = $"{s.SensorTypeKey} {s.DriverDisplayName}"; var name = s.Name; if (driver.Contains("gas", StringComparison.OrdinalIgnoreCase) || name.Contains("gas", StringComparison.OrdinalIgnoreCase)) return "Gas"; if (driver.Contains("steam", StringComparison.OrdinalIgnoreCase) || name.Contains("steam", StringComparison.OrdinalIgnoreCase) || name.Contains("boiler", StringComparison.OrdinalIgnoreCase)) return "Steam"; if (driver.Contains("ph", StringComparison.OrdinalIgnoreCase) || name.Contains("ph", StringComparison.OrdinalIgnoreCase) || name.Contains("chlor", StringComparison.OrdinalIgnoreCase) || name.Contains("turb", StringComparison.OrdinalIgnoreCase)) return "Water Quality"; if (driver.Contains("temp", StringComparison.OrdinalIgnoreCase) || driver.Contains("humid", StringComparison.OrdinalIgnoreCase) || name.Contains("temperature", StringComparison.OrdinalIgnoreCase)) return "Temperature & RH"; if (driver.Contains("power", StringComparison.OrdinalIgnoreCase) || name.Contains("current", StringComparison.OrdinalIgnoreCase) || name.Contains("vibr", StringComparison.OrdinalIgnoreCase)) return "Electrical & Mechanical"; if (driver.Contains("air", StringComparison.OrdinalIgnoreCase) || name.Contains("pressure", StringComparison.OrdinalIgnoreCase)) return "Air"; if (driver.Contains("flow", StringComparison.OrdinalIgnoreCase) || name.Contains("water", StringComparison.OrdinalIgnoreCase) || name.Contains("level", StringComparison.OrdinalIgnoreCase)) return "Water"; return "Other"; }
    private LiveTelemetryState.MeterState? Snapshot(ScadaDemoTestApiClient.AttachedSensorDto s) => Live.GetMeterSnapshot(s.UniqueSensorId);
    private IEnumerable<KeyValuePair<string, (double Value, string? Unit, DateTime Seen)>> FreshMetrics(ScadaDemoTestApiClient.AttachedSensorDto s) { var snapshot = Snapshot(s); if (snapshot is null) return []; var selected = SelectedMetricKeys(s); var cutoff = DateTime.UtcNow.AddSeconds(-60); return snapshot.Values.Where(v => selected.Contains(v.Key) && v.Value.Seen >= cutoff); }
    private string LiveTrendPoints(ScadaDemoTestApiClient.AttachedSensorDto sensor, string metric)
    {
        var history = Snapshot(sensor)?.History;
        if (history is null || !history.TryGetValue(metric, out var samples)) return "";
        var recent = samples.Where(x => x.Seen >= DateTime.UtcNow.AddSeconds(-60)).TakeLast(12).ToList();
        if (recent.Count < 2) return "";

        var min = recent.Min(x => x.Value);
        var max = recent.Max(x => x.Value);
        var span = Math.Max(max - min, Math.Max(Math.Abs(max), 1) * 0.02);
        return string.Join(" ", recent.Select((sample, index) =>
            $"{1 + 98d * index / (recent.Count - 1):0.##},{22 - (sample.Value - min) / span * 20:0.##}"));
    }
    private sealed record TrendMarker(double X, double Y);
    private IReadOnlyList<TrendMarker> TrendMarkers => BuildTrendMarkers();
    private string TrendPoints => string.Join(" ", TrendMarkers.Select(p => $"{p.X:0.##},{p.Y:0.##}"));
    private string TrendStartLabel => DetailHistory.Count == 0 ? "" : DetailHistory[0].TimestampUtc.ToLocalTime().ToString("HH:mm:ss");
    private string TrendEndLabel => DetailHistory.Count == 0 ? "" : DetailHistory[^1].TimestampUtc.ToLocalTime().ToString("HH:mm:ss");
    private string TrendMinLabel => DetailHistory.Count == 0 ? "" : DetailHistory.Min(x => x.PrimaryValue).ToString("0.##");
    private string TrendMaxLabel => DetailHistory.Count == 0 ? "" : DetailHistory.Max(x => x.PrimaryValue).ToString("0.##");
    private IReadOnlyList<TrendMarker> BuildTrendMarkers()
    {
        if (DetailHistory.Count == 0) return [];
        var min = DetailHistory.Min(x => x.PrimaryValue);
        var max = DetailHistory.Max(x => x.PrimaryValue);
        var span = Math.Max(max - min, Math.Max(Math.Abs(max), 1) * 0.02);
        return DetailHistory.Select((p, i) => new TrendMarker(
            48 + (DetailHistory.Count == 1 ? 326 : 652d * i / (DetailHistory.Count - 1)),
            188 - ((p.PrimaryValue - min) / span * 150))).ToList();
    }
    private static HashSet<string> SelectedMetricKeys(ScadaDemoTestApiClient.AttachedSensorDto s)
    {
        if (string.IsNullOrWhiteSpace(s.MetricFields))
        {
            return s.SensorTypeKey.Equals("AOSONG_AQ3485", StringComparison.OrdinalIgnoreCase)
                ? new HashSet<string>(["TemperatureC", "HumidityRH"], StringComparer.OrdinalIgnoreCase)
                : new HashSet<string>(["InstantaneousFlowRate", "AccumulatedTotalizer"], StringComparer.OrdinalIgnoreCase);
        }
        try { return (JsonSerializer.Deserialize<Dictionary<string, string>>(s.MetricFields) ?? []).Keys.ToHashSet(StringComparer.OrdinalIgnoreCase); }
        catch { return []; }
    }
    private IEnumerable<KeyValuePair<string, (double Value, string? Unit, DateTime Seen)>> CardMetrics(ScadaDemoTestApiClient.AttachedSensorDto s)
    {
        var live = FreshMetrics(s).ToList();
        if (live.Count > 0) return live;

        var primaryKey = s.SensorTypeKey.Equals("AOSONG_AQ3485", StringComparison.OrdinalIgnoreCase)
            ? "TemperatureC"
            : "InstantaneousFlowRate";
        var secondaryKey = s.SensorTypeKey.Equals("AOSONG_AQ3485", StringComparison.OrdinalIgnoreCase)
            ? "HumidityRH"
            : "AccumulatedTotalizer";
        var selected = SelectedMetricKeys(s);
        var seen = s.LatestTimestampUtc ?? DateTime.MinValue;
        var saved = new List<KeyValuePair<string, (double Value, string? Unit, DateTime Seen)>>();

        if (s.LatestPrimary.HasValue && selected.Contains(primaryKey))
            saved.Add(new(primaryKey, (s.LatestPrimary.Value, s.UnitPrimary, seen)));
        if (s.LatestSecondary.HasValue && selected.Contains(secondaryKey))
            saved.Add(new(secondaryKey, (s.LatestSecondary.Value, s.UnitSecondary, seen)));

        return saved;
    }
